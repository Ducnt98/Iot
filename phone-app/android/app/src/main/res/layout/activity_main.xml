<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HỆ THỐNG GỌI HỖ TRỢ"
            android:textColor="#173C78"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            android:textColor="#6E7D91"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="18dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_panel"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kết nối MQTT Broker"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#202E43"/>

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa kết nối"
                android:textColor="#A04C1C"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/editHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="IP máy tính (ví dụ 192.168.1.10)"
                android:inputType="textUri"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/editPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="MQTT port"
                android:inputType="number"
                android:text="1883"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/editUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="MQTT username"
                android:inputType="text"
                android:singleLine="true"
                android:text="support"/>

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="MQTT password"
                android:inputType="textPassword"
                android:singleLine="true"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kết nối"
                    android:textAllCaps="false"/>

                <Button
                    android:id="@+id/btnDisconnect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Ngắt kết nối"
                    android:textAllCaps="false"
                    android:enabled="false"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_panel"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gửi yêu cầu hỗ trợ"
                android:textColor="#202E43"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/editDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mã thiết bị ESP32"
                android:text="esp32-audio-01"
                android:inputType="text"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/editLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Vị trí/phòng"
                android:text="A101"
                android:inputType="text"
                android:singleLine="true"/>

            <Button
                android:id="@+id/btnSupport"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#16764E"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="GỌI HỖ TRỢ"
                android:enabled="false"/>

            <Button
                android:id="@+id/btnSos"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#B63138"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="SOS KHẨN CẤP"
                android:enabled="false"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#6E7D91"
                android:textSize="12sp"
                android:text="Yêu cầu được gửi qua máy tính MQTT Broker. ESP32 phát file âm thanh ghi sẵn."/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_panel"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nhật ký hoạt động"
                android:textColor="#202E43"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/textLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa có sự kiện."
                android:textColor="#33445A"
                android:textSize="13sp"
                android:paddingTop="10dp"
                android:textIsSelectable="true"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
